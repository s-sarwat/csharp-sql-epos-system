<Window x:Class="Comp_Sci___EPOS_System.TableSelection"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Comp_Sci___EPOS_System"
        mc:Ignorable="d"
        Title="TableSelection" Height="799.4" Width="1600" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <TextBlock HorizontalAlignment="Left" Margin="28,22,0,0" TextWrapping="Wrap" Text="Select a Table" VerticalAlignment="Top" Height="50" Width="441" FontSize="36"/>
        <Button x:Name="Table1" Content="Table 1" HorizontalAlignment="Left" Margin="232,130,0,0" VerticalAlignment="Top" Height="150" Width="200" FontSize="20" BorderBrush="{x:Null}" Click="Button_Click"/>
        <Button x:Name="Table2" Content="Table 2" HorizontalAlignment="Left" Margin="232,0,0,0" VerticalAlignment="Center" Height="150" Width="200" FontSize="20" BorderBrush="{x:Null}" Click="Button_Click"/>
        <Button x:Name="Table3" Content="Table 3" HorizontalAlignment="Left" Margin="232,505,0,0" VerticalAlignment="Top" Height="150" Width="200" FontSize="20" BorderBrush="{x:Null}" Click="Button_Click"/>
        <Ellipse HorizontalAlignment="Center" Height="150" Margin="0,130,0,0" VerticalAlignment="Top" Width="200" Fill="#FFDDDDDD" IsHitTestVisible="False"/>
        <Ellipse HorizontalAlignment="Center" Height="150" VerticalAlignment="Center" Width="200" Fill="#FFDDDDDD" IsHitTestVisible="False"/>
        <Ellipse HorizontalAlignment="Center" Height="150" Margin="0,505,0,0" VerticalAlignment="Top" Width="200" Fill="#FFDDDDDD" IsHitTestVisible="False"/>
        <Button x:Name="Table4" Content="Table 4" HorizontalAlignment="Center" Margin="0,130,0,0" VerticalAlignment="Top" Height="150" Width="200" FontSize="20" Background="{x:Null}" BorderBrush="{x:Null}" Click="Button_Click"/>
        <Button x:Name="Table5" Content="Table 5" HorizontalAlignment="Center" VerticalAlignment="Center" Height="150" Width="200" FontSize="20" BorderBrush="{x:Null}" Background="{x:Null}" Click="Button_Click"/>
        <Button x:Name="Table6" Content="Table 6" HorizontalAlignment="Center" VerticalAlignment="Top" Height="150" Width="200" FontSize="20" Margin="0,505,0,0" BorderBrush="{x:Null}" Background="{x:Null}" Click="Button_Click"/>
        <Button x:Name="Table7" Content="Table 7" HorizontalAlignment="Left" Margin="1170,130,0,0" VerticalAlignment="Top" Height="150" Width="200" FontSize="20" BorderBrush="{x:Null}" Click="Button_Click"/>
        <Button x:Name="Table8" Content="Table 8" HorizontalAlignment="Left" Margin="1170,0,0,0" VerticalAlignment="Center" Height="150" Width="200" FontSize="20" BorderBrush="{x:Null}" Click="Button_Click"/>
        <Button x:Name="Table9" Content="Table 9" HorizontalAlignment="Left" Margin="1170,505,0,0" VerticalAlignment="Top" Height="150" Width="200" FontSize="20" BorderBrush="{x:Null}" Click="Button_Click"/>

    </Grid>
</Window>

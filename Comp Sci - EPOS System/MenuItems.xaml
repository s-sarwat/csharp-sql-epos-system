<Window x:Class="Comp_Sci___EPOS_System.MenuItems"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Comp_Sci___EPOS_System"
        mc:Ignorable="d"
        Title="MenuItems" Height="800" Width="1600" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#FFADADAD">
    <Grid>
        <DataGrid x:Name="MenuDataGrid" d:ItemsSource="{d:SampleData ItemCount=5}" ItemsSource="{Binding}" AutoGenerateColumns="True" FontSize="18" Margin="0,0,0,76" Focusable="False">
            <!--<DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="50" />
                <DataGridTextColumn Header="Name" Binding="{Binding FirstName}" Width="*"/>
                <DataGridTextColumn Header="Price" Binding="{Binding LastName}" Width="100"/>
                <DataGridTextColumn Header="GroupId" Binding="{Binding Email}" Width="100"/>
            </DataGrid.Columns>-->
        </DataGrid>
        <Button Content="DELETE" FontSize="20" HorizontalAlignment="Center" Margin="0,713,0,0" VerticalAlignment="Top" Height="47" Width="114" Click="btnDelete_Click"/>

    </Grid>
</Window>

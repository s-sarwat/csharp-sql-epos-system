<Window x:Class="Comp_Sci___EPOS_System.BookingOptionBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Comp_Sci___EPOS_System"
        mc:Ignorable="d"
        Title="Select an option" Height="500" Width="300" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" WindowStyle="ToolWindow">
    <Grid>
        <Button x:Name="existingBtn" Content="Manage existing bookings" HorizontalAlignment="Center" Margin="0,20,0,0" VerticalAlignment="Top" Height="34" Width="280"/>
        <Button x:Name="createBtn" Content="Create a new booking" HorizontalAlignment="Center" Margin="0,76,0,0" VerticalAlignment="Top" Height="34" Width="280" Click="createBtn_Click"/>
        <Button x:Name="backBtn" Content="Back" HorizontalAlignment="Center" Margin="0,398,0,0" VerticalAlignment="Top" Height="34" Width="78" Click="backBtn_Click"/>

    </Grid>
</Window>

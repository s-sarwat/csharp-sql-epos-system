<Window x:Class="Comp_Sci___EPOS_System.CreateBooking"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Comp_Sci___EPOS_System"
        mc:Ignorable="d"
        Title="Create a new booking" Height="800" Width="1600" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#FFADADAD">
    <Grid>
        <TextBox x:Name="FirstName_Box" HorizontalAlignment="Left" Margin="320,15,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="504" Height="36" FontSize="24" Background="#FFC5C5C5"/>
        <TextBlock x:Name="FirstName_Text" HorizontalAlignment="Left" Margin="78,17,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="24" Width="139"><Run Language="en-gb" Text="First Name:"/></TextBlock>
        <TextBlock x:Name="LastName_Text" HorizontalAlignment="Left" Margin="78,86,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="24" Width="139"><Run Language="en-gb" Text="Last Name:"/></TextBlock>
        <TextBlock x:Name="PhoneNum_Text" HorizontalAlignment="Left" Margin="78,230,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="24" Width="195" Text="Phone Number:"/>
        <TextBox x:Name="LastName_Box" HorizontalAlignment="Left" Margin="320,86,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="504" Height="36" FontSize="24" Background="#FFC5C5C5"/>
        <TextBox x:Name="PhoneNum_Box" HorizontalAlignment="Left" Margin="320,230,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="504" Height="36" FontSize="24" Background="#FFC5C5C5"/>
        <TextBlock x:Name="Date_Text" HorizontalAlignment="Left" Margin="78,303,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="24" Width="139"><Run Language="en-gb" Text="Date:"/></TextBlock>
        <TextBlock x:Name="Time_Text" HorizontalAlignment="Left" Margin="78,374,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="24" Width="139"><Run Language="en-gb" Text="Time:"/></TextBlock>
        <TextBlock x:Name="NoGuests_Text" HorizontalAlignment="Left" Margin="78,438,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="24" Width="195"><Run Language="en-gb" Text="No. of guests:"/></TextBlock>
        <TextBlock x:Name="Instructions_Text" HorizontalAlignment="Left" Margin="78,562,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="24" Width="227"><Run Language="en-gb" Text="Special Instructions:"/></TextBlock>
        <TextBox x:Name="Instructions_Box" HorizontalAlignment="Left" Margin="320,562,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="504" Height="102" FontSize="16" Background="#FFC5C5C5" Text="E.g. Baby highchair, Window table, etc." Foreground="Gray" GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus"/>
        <TextBlock x:Name="Email_Text" HorizontalAlignment="Left" Margin="78,163,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="24" Width="195" Text="Email Address:"/>
        <TextBox x:Name="Email_Box" HorizontalAlignment="Left" Margin="320,161,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="504" Height="36" FontSize="24" Background="#FFC5C5C5"/>
        <DatePicker x:Name="SelectDate" HorizontalAlignment="Left" Margin="320,303,0,0" VerticalAlignment="Top" Height="32" Width="206"/>
        <ComboBox x:Name="NoGuests_Box" HorizontalAlignment="Left" Margin="320,438,0,0" VerticalAlignment="Top" Width="504" Height="36" AllowDrop="True">
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" Content="1" FontSize="16"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" Content="2" FontSize="16"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" Content="3" FontSize="16"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" Content="4" FontSize="16"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" Content="5" FontSize="16"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" FontSize="16" Content="6"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" FontSize="16" Content="7"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" FontSize="16" Content="8"/>
        </ComboBox>
        <ComboBox x:Name="TimeSlot_Box" HorizontalAlignment="Left" Margin="320,0,0,0" VerticalAlignment="Center" Width="504" Height="36" AllowDrop="True">
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" Content="10:00AM" FontSize="16"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" Content="10:30AM" FontSize="16"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" Content="11:00AM" FontSize="16"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" Content="11:30AM" FontSize="16"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" Content="12:00PM" FontSize="16"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" FontSize="16" Content="12:30PM"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" FontSize="16" Content="1:00PM"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" FontSize="16" Content="1:30PM"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" Content="2:00PM" FontSize="16"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" Content="2:30PM" FontSize="16"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" Content="3:00PM" FontSize="16"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" Content="3:30PM" FontSize="16"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" Content="4:00PM" FontSize="16"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" FontSize="16" Content="4:30PM"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" FontSize="16" Content="5:00PM"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" FontSize="16" Content="5:30PM"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" FontSize="16" Content="6:00PM"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" FontSize="16" Content="6:30PM"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" FontSize="16" Content="7:00PM"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" FontSize="16" Content="7:30PM"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" FontSize="16" Content="8:00PM"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" FontSize="16" Content="8:30PM"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" FontSize="16" Content="9:00PM"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" FontSize="16" Content="9:30PM"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" FontSize="16" Content="10:00PM"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" FontSize="16" Content="10:30PM"/>
        </ComboBox>
        <Button Content="BACK" HorizontalAlignment="Left" Margin="26,680,0,0" VerticalAlignment="Top" Height="47" Width="132" Click="BackBtn_Click" Background="#FFFBFBFB" Style="{DynamicResource RoundedButtonStyle}" FontSize="20"/>
        <Button Content="CONTINUE" HorizontalAlignment="Left" Margin="1431,688,0,0" VerticalAlignment="Top" Height="47" Width="132" Click="continueBtn_Click" Background="#FFFBFBFB" Style="{DynamicResource RoundedButtonStyle}" FontSize="20" IsDefault="True"/>
        <TextBlock x:Name="TableText" HorizontalAlignment="Left" Margin="78,501,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="24" Width="208"><Run Language="en-gb" Text="Table number:"/></TextBlock>
        <ComboBox x:Name="TableSelector" HorizontalAlignment="Left" Margin="320,501,0,0" VerticalAlignment="Top" Width="504" Height="36" AllowDrop="True">
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" Content="Table 1" FontSize="16"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" Content="Table 2" FontSize="16"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" Content="Table 3" FontSize="16"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" Content="Table 4" FontSize="16"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" Content="Table 5" FontSize="16"/>
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" Content="Table 6" FontSize="16" />
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" Content="Table 7" FontSize="16" />
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" Content="Table 8" FontSize="16" />
            <ComboBoxItem Background="{x:Null}" BorderBrush="{x:Null}" Content="Table 9" FontSize="16"/>
        </ComboBox>

    </Grid>
</Window>

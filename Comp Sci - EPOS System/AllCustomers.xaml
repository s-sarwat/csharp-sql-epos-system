<Window x:Name="Manage_all_customers" x:Class="Comp_Sci___EPOS_System.AllCustomers"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Comp_Sci___EPOS_System"
        mc:Ignorable="d"
        Title="Manage all customers" Height="800" Width="1600" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <DataGrid x:Name="CustomersDataGrid" d:ItemsSource="{d:SampleData ItemCount=5}" ItemsSource="{Binding}" AutoGenerateColumns="False" FontSize="18" Margin="0,0,0,76" Focusable="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="50" />
                <DataGridTextColumn Header="FirstName" Binding="{Binding FirstName}" Width="*"/>
                <DataGridTextColumn Header="LastName" Binding="{Binding LastName}" Width="*"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="*"/>
                <DataGridTextColumn Header="City" Binding="{Binding City}" Width="100"/>
                <DataGridTextColumn Header="Postcode" Binding="{Binding Postcode}" Width="100"/>
                <DataGridTextColumn Header="PhoneNumber" Binding="{Binding PhoneNumber}" Width="150"/>
                <DataGridTextColumn Header="Instructions" Binding="{Binding Instructions}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button Content="DELETE" HorizontalAlignment="Center" Margin="0,713,0,0" VerticalAlignment="Top" Height="38" Width="96" Click="DeleteButton_Click"/>

    </Grid>
</Window>

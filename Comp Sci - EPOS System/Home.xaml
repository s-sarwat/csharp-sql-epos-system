<Window x:Class="Comp_Sci___EPOS_System.Home"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Comp_Sci___EPOS_System"
        mc:Ignorable="d"
        Width="1600"  
        Height="800"
        Title="Home" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="White">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <Style TargetType="Grid">
                <Setter Property="ShowGridLines" Value="False"/>
            </Style>
        </Grid.Resources>

        <!--<Button x:Name="LogoutButton" Grid.Column="2" Content="test" HorizontalAlignment="Left" Margin="396,205,0,0" Grid.Row="2" VerticalAlignment="Top" Height="56" Width="137" Click="ShowLogin"/>-->
        <Button Grid.Column="2" Content="LOGOUT" HorizontalAlignment="Left" Margin="403,206,0,0" Grid.Row="2" VerticalAlignment="Top" Height="55" Width="130" Click="ShowLogin" FontSize="36"/>
        <Button Grid.Column="2" Content="SETTINGS" HorizontalAlignment="Left" Margin="235,205,0,0" Grid.Row="2" VerticalAlignment="Top" Height="56" Width="158" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="{x:Null}" Click="btnSettings_Click" FontSize="36"/>

        <Rectangle Grid.Column="0" IsHitTestVisible="False" Grid.ColumnSpan="3" HorizontalAlignment="Center" Height="56" Margin="0,205,0,0" Grid.Row="2" VerticalAlignment="Top" Width="1600" Fill="#FF383838" IsEnabled="False"/>
        <Image Source="/Logout.png " IsHitTestVisible="False"
        Width="30" Height="26"
        HorizontalAlignment="Left" VerticalAlignment="Top"
        Margin="408,220,0,0" Grid.Column="2" Grid.Row="2" IsEnabled="False" />
        <TextBlock IsHitTestVisible="False" Grid.Column="2" HorizontalAlignment="Left" Margin="444,222,0,0" Grid.Row="2" TextWrapping="Wrap" Text="LOGOUT" VerticalAlignment="Top" Foreground="White" FontFamily="Arial" Height="22" Width="79" FontSize="18" IsEnabled="False"/>
        <Image Source="/SETTINGS.png" IsHitTestVisible="False"
            Width="30" Height="26"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            Margin="249,220,0,0" Grid.Column="2" Grid.Row="2" IsEnabled="False" />
        <TextBlock IsHitTestVisible="False" Grid.Column="2" HorizontalAlignment="Left" Margin="284,222,0,0" Grid.Row="2" TextWrapping="Wrap" Text="SETTINGS" VerticalAlignment="Top" Foreground="White" FontFamily="Arial" Height="22" Width="95" FontSize="18" IsEnabled="False"/>
 
        <Button Content="DELIVERY" HorizontalAlignment="Center" Grid.Row="1" VerticalAlignment="Center" Height="152" Width="310" BorderBrush="{x:Null}" Background="#FFE0E0E0" FontFamily="Bahnschrift SemiLight" FontSize="36" Click="btnDelivery_Click"/>
        <Button Content="EAT IN" HorizontalAlignment="Center" Grid.Row="1" VerticalAlignment="Center" Height="152" Width="310" BorderBrush="{x:Null}" Background="#FFE0E0E0" FontFamily="Bahnschrift SemiLight" FontSize="36" Grid.Column="1" Click="btnEatIn_Click"/>
        <Button Content="TAKEAWAY" HorizontalAlignment="Left" Grid.Row="1" VerticalAlignment="Center" Height="152" Width="310" BorderBrush="{x:Null}" Background="#FFE0E0E0" FontFamily="Bahnschrift SemiLight" FontSize="36" Grid.Column="2" Margin="107,0,0,0" Click="btnTakeaway_Click"/>
        <Button Content="BOOKINGS" HorizontalAlignment="Center" Grid.Row="1" VerticalAlignment="Top" Height="65" Width="310" BorderBrush="{x:Null}" Background="#FFE0E0E0" FontFamily="Bahnschrift SemiLight" FontSize="36" Grid.ColumnSpan="2" Margin="0,245,0,0" Grid.RowSpan="2" Click="btnBookings_Click"/>
        <Button Content="ORDERS" HorizontalAlignment="Left" Grid.Row="1" VerticalAlignment="Top" Height="65" Width="310" BorderBrush="{x:Null}" Background="#FFE0E0E0" FontFamily="Bahnschrift SemiLight" FontSize="36" Grid.ColumnSpan="2" Margin="379,245,0,0" Grid.RowSpan="2" Grid.Column="1" Click="btnOrders_Click"/>

    </Grid>



</Window>

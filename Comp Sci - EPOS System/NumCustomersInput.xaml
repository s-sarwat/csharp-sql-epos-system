<Window x:Class="Comp_Sci___EPOS_System.NumCustomersInput"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Comp_Sci___EPOS_System"
        mc:Ignorable="d"
        Title="Input Box" Height="200" Width="250" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#FFD8D8D8">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Label Content="Please enter the number of customers:" Margin="5"/>
        <TextBox Grid.Row="1" Name="txtCustomerNum" Margin="5" PreviewTextInput="txtBox_PreviewTextInput" PreviewKeyDown="Box_PreviewKeyDown"/>
        <Button Grid.Row="2" Content="OK" Margin="5" Click="Button_Click" Background="#FFEFEBEB"/>
        <Label Grid.Row="3" Name="Label" Margin="5"/>
    </Grid>
</Window>
